# GEXLens — příklad konfigurace enginu.
# Zkopíruj jako `.env` a uprav. Všechny položky mají defaulty (viz engine/src/gexlens_engine/config.py);
# stačí nastavit jen to, co měníš. `.env` je v .gitignore — nikdy ho necommituj.

# Dev stack: odchylky patří do `.env.dev` (viz .env.dev.example) — čte se
# PO tomto souboru a přepisuje hodnoty jen pro dev kontejnery (#696).
#
# ── IBKR připojení (SPEC 3.1) ────────────────────────────────────
GEXLENS_IBKR_HOST=127.0.0.1
# 7496 = TWS live, 7497 = TWS paper, 4001/4002 = IB Gateway defaulty
GEXLENS_IBKR_PORT=7496
GEXLENS_IBKR_CLIENT_ID=1
# 1 = live; delayed data engine odmítá (Greeks z nich nejsou spolehlivé)
GEXLENS_MARKET_DATA_TYPE=1
# Timeout connectu [s] a exponenciální backoff reconnectu (SPEC 3.1: 2 → 60 s)
GEXLENS_CONNECT_TIMEOUT_S=10
GEXLENS_RECONNECT_BACKOFF_BASE_S=2
GEXLENS_RECONNECT_BACKOFF_MAX_S=60

# ── Instrumenty (ADR-0003) ──────────────────────────────────────
# Základní sada futures podkladů (čárkami oddělený seznam); watchlist z UI se přidává za běhu
GEXLENS_SYMBOLS=ES
# Strop souběžně běžících instrumentů (rozpočet market data lines)
GEXLENS_MAX_INSTRUMENTS=3
# Watchlist z DB se čte každý k-tý minutový cyklus
GEXLENS_WATCHLIST_POLL_CYCLES=5
# Ranní OI archiv pokrývá N nejbližších expirací (ΔOI vs. včera)
GEXLENS_OI_ARCHIVE_EXPIRIES=5
# Sweep následující expirace (positioning příští seance) v kadenci každý k-tý cyklus
GEXLENS_SWEEP_NEXT_EXPIRY=true
GEXLENS_NEXT_EXPIRY_SWEEP_EVERY=3
# Maximální stáří kotace použitelné pro výpočty (#306, sekundy). Starší data se
# do GEX, úrovní ani Dyn GEX profilu nezapočítají — řádek snapshotu se zapíše dál,
# ale se skutečným stářím, takže chybějící strike je vidět místo zmrzlých čísel.
GEXLENS_QUOTE_MAX_AGE_S=900
# Alert greeks_stalled: podíl stale kontraktů nad prahem po N po sobě jdoucích sweepech
GEXLENS_GREEKS_STALL_SHARE=0.1
GEXLENS_GREEKS_STALL_CYCLES=3
# Setup detektor (ADR-0004): analýzy s auto-vyhodnocováním; ukládá do PG tabulky setups
GEXLENS_SETUPS_ENABLED=true
# Minimální dominance zdi pro šablony T1/T3 (ADR-0010; podíl zdi na síle strany, 0–1)
GEXLENS_SETUP_MIN_WALL_DOMINANCE=0.15
# Kontra-režimový filtr (#252 B+C): fade proti gammě vyžaduje CumΔ konfluenci přes
# delší okno (min); po stopu kontra-setupu má šablona delší cooldown (min)
GEXLENS_SETUP_COUNTER_FLOW_LOOKBACK=30
GEXLENS_SETUP_COUNTER_STOP_COOLDOWN_MINUTES=45
# Vypnuté šablony setupů (#303): čárkami oddělené kódy (wall_bounce, failed_break,
# max_pain_pin, gamma_momentum, divergence_spring); prázdné = běží všechny.
# T5 divergence_spring vypnuta — 8,7 % úspěšnost, Ø −0,69R za 23 setupů
GEXLENS_SETUP_DISABLED_TEMPLATES=divergence_spring
# R-mechanika setupů (#302). Prahy jsou v násobcích ATR(14) minutových barů, ne
# v bodech — ATR je medián 1,57 b na ES vs. 11,52 b na NQ, absolutní buffer by
# na každém instrumentu znamenal jinak velký risk.
# Minimální risk (stop pod ním leží v minutovém šumu):
GEXLENS_SETUP_MIN_RISK_ATR=2.0
# Strop vzdálenosti cíle v násobcích risku (dál = cíl nedosažitelný):
GEXLENS_SETUP_MAX_RR=3.0
# Po N stopech v řadě v jednom směru se směr na X minut zablokuje (napříč šablonami):
GEXLENS_SETUP_MAX_STOPS_PER_DIRECTION=3
GEXLENS_SETUP_DIRECTION_BLOCK_MINUTES=90
# Sebekontrola detektoru (#309): denně po ranním OI archivu se vyhodnotí klouzavé
# okno; při propadu ΣR pod práh přijde alert setup_degraded. Zdravý stav jde jen
# do logu, aby zvonek nezevšedněl.
GEXLENS_SETUP_SELFCHECK_DAYS=7
GEXLENS_SETUP_SELFCHECK_MIN_SAMPLES=10
GEXLENS_SETUP_SELFCHECK_MAX_DRAWDOWN_R=-10
# Flow-adjusted OI odhad (ADR-0011): OI_est = ranní OI + α·čistý klasifikovaný objem;
# α z validace open-ratio (~0,39 na čistém dni), 0 = vrstva vypnutá
GEXLENS_FLOW_OI_ALPHA=0.4
# Vol leadeři (#208): alert při koncentraci na příští expiraci — leader ≥ ratio ×
# medián top-10 stran a zároveň ≥ min_volume kontraktů
GEXLENS_VOL_LEADER_RATIO=3.0
GEXLENS_VOL_LEADER_MIN_VOLUME=500
# GEX zebrik (#244): top-N vyznamnych striku per strana + minimalni podil na sile strany
GEXLENS_LADDER_TOP_N=3
GEXLENS_LADDER_MIN_SHARE=0.1

# ── Opční řetězec a scheduler (SPEC 3.2, 3.3) ────────────────────
# Výchozí denní obálka strikes: spot ±X bodů (reset na session start)
GEXLENS_STRIKE_RANGE_POINTS=200
# Auto-rozšíření obálky při přiblížení spotu k okraji na < 25 % šířky (grow-only, ADR-0002)
GEXLENS_STRIKE_RANGE_EXPAND_THRESHOLD=0.25
# Strop šířky obálky; při dosažení se obálka posouvá za spotem (alert)
GEXLENS_STRIKE_RANGE_MAX_POINTS=800
# Velikost rotační dávky subskripcí
GEXLENS_BATCH_SIZE=80
# Timeout čekání na kompletní data dávky [s]
GEXLENS_BATCH_TIMEOUT_S=4
# Publikační okno denního OI (#463, #511): burzovní čas + IANA zóna — DST řeší
# zoneinfo (default 07:00 America/Chicago = 12:00 UTC v létě, 13:00 v zimě).
# Snímek pořízený dřív nese předpublikační čísla a po tomto čase se povinně obnoví.
GEXLENS_OI_PUBLICATION_TIME_LOCAL=07:00
GEXLENS_OI_PUBLICATION_TZ=America/Chicago
# DEPRECATED (#511): stará fixní UTC hodina — funguje dál (má přednost), ale
# loguje warning; nahraď ji dvojicí výše
# GEXLENS_OI_PUBLICATION_HOUR_UTC=12
# Finalita snímku (#664): dvě shodná čtení ho prohlásí za finální jen při
# pokrytí aspoň tohoto podílu řetězce — řídký 0DTE snímek nesmí zastavit obnovu
GEXLENS_OI_FINAL_MIN_COVERAGE=0.9
# Křídla řetězce se sweepují každý k-tý cyklus; ATM±šířka každý cyklus
GEXLENS_WINGS_SWEEP_EVERY=3
GEXLENS_ATM_SWEEP_WIDTH=30
# Max pokusů repair fronty na kontrakt za sweep
GEXLENS_REPAIR_MAX_ATTEMPTS=3
# Repair backoff per kontrakt (#547): odklad po k. neúspěšném kole je
# 0 → base → 2·base → … → strop [s]; po N kolech alert strikes_stalled
GEXLENS_REPAIR_BACKOFF_BASE_S=4
GEXLENS_REPAIR_BACKOFF_MAX_S=300
GEXLENS_REPAIR_STALL_ROUNDS=10
# Fallback vlastních Greeks (#547): po N sweepech s živými kotacemi bez TWS
# modelGreeks se greeks dopočítají BS modelem z mid ceny (IV inverzí)
GEXLENS_GREEKS_FALLBACK_SWEEPS=3
# Kapacita market data lines účtu (ADR-0001: naměřeno >= 150)
GEXLENS_MARKET_DATA_LINES=100

# Tichá ztráta 5s barů (#221): alert po N minutách bez baru při živém spotu
GEXLENS_BARS_STALL_ALERT_MINUTES=3

# ── Hot zóna (SPEC 3.4; limity účtu viz docs/adr/0001) ──────────
# Cílová šířka hot zóny: ATM ± N strikes
GEXLENS_HOT_ZONE_WIDTH=15
# Max souběžných tick-by-tick streamů (naměřený limit účtu = 5)
GEXLENS_TICK_BY_TICK_MAX_STREAMS=5

# ── Bezpečnost (#542) ───────────────────────────────────────────
# Tajemství NEPIŠ do repa — vygeneruj je do lokálního .env příkazem
#   pwsh scripts/init-secrets.ps1
# Heslo k PostgreSQL. Compose bez něj vůbec nenastartuje (žádný slabý default).
GEXLENS_PG_PASSWORD=
# Sdílené tajemství pro /internal/* (engine → API) a /backup/postgres.
# Prázdná hodnota = API tyto endpointy odmítá, engine nemá čím publikovat.
GEXLENS_API_TOKEN=
# Adresa, na které compose publikuje porty. Loopback drží stack mimo síť;
# na serveru sem patří Tailscale IP, NIKDY 0.0.0.0 (Docker obchází UFW).
GEXLENS_BIND_ADDR=127.0.0.1

# ── Storage a retence (SPEC kap. 5) ─────────────────────────────
# PostgreSQL (OI archiv + metadata); heslo doplň z GEXLENS_PG_PASSWORD výše
GEXLENS_DATABASE_URL=postgresql+psycopg://gexlens:zmen-me@localhost:5432/gexlens
GEXLENS_DATA_DIR=data
# Okno purge partic (ADR-0022: 90 dní, odchylka od R3 kvůli backtestům
# a prohlížení starších dnů); ~1,5 GB pro ES+NQ
GEXLENS_RETENTION_DAYS=90
# Rozsah startovního backfillu barů — ZÁMĚRNĚ nezávislý na retenci:
# backfill nepřeskakuje dny, které už na disku jsou, takže širší okno
# znamená víc historických dotazů na IBKR při každém restartu
GEXLENS_BARS_BACKFILL_DAYS=14
# Věčný archiv 1min barů podkladu (SentimentLens S4, #275): výjimka z retence
# jako u OI archivu — bez něj nejde volume z-score reakčních oken (20 seancí)
# ani zpětný přepočet reakcí na zprávy. Objem desítky MB/rok.
GEXLENS_KEEP_BARS_FOREVER=true
GEXLENS_DISK_LIMIT_GB=5
# Čas nočního purge jobu (UTC, po zavření US seance)
GEXLENS_RETENTION_PURGE_TIME_UTC=21:30

# ── SentimentLens news-engine (SPEC S10: klíče jen lokálně, nikdy v gitu) ────────
GEXLENS_NEWS_DATABASE_URL=postgresql+psycopg://gexlens:zmen-me@localhost:55432/gexlens
# Prázdný klíč = zdroj se nespustí (není to porucha, jen vypnutý zdroj)
GEXLENS_NEWS_FINNHUB_API_KEY=
GEXLENS_NEWS_FRED_API_KEY=
GEXLENS_NEWS_BLS_API_KEY=
GEXLENS_NEWS_BEA_API_KEY=
GEXLENS_NEWS_GEMINI_API_KEY=
# Gemini batch klasifikace (#281) — ZAKONZERVOVÁNO (#740 fáze 0), default
# vypnuto. Účet je free tier, takže větev naráží na denní kvótu (#738), a
# měřením se ukázalo, že hodnotu nepřidává: v `news_weights` neprošla Wilson
# gate ani jednou (0 z 20 řádků, hit rate 0,484 vs. 0,516 u pravidel).
# Klíč v .env sám o sobě větev NEZAPNE — je k tomu potřeba tenhle flag.
# Kód i historických 15 747 klasifikací zůstávají kvůli srovnání s #740.
GEXLENS_NEWS_LLM_ENABLED=false
# Model, kadence dávek, denní strop requestů a max eventů v jedné dávce.
# Pozn.: `gemini-flash-latest` je POSUVNÝ ALIAS — Google pod ním 13. 8. vyměnil
# model a request začal padat na 400 „Thinking level MINIMAL is not supported"
# (#738). Při případném zapnutí pinovat konkrétní verzi.
GEXLENS_NEWS_GEMINI_MODEL=gemini-flash-latest
GEXLENS_NEWS_LLM_INTERVAL_S=60
GEXLENS_NEWS_LLM_DAILY_LIMIT=1400
GEXLENS_NEWS_LLM_BATCH_LIMIT=200
# Reddit vyžaduje OAuth i pro čtení (ADR-0014) — script app na reddit.com/prefs/apps
GEXLENS_NEWS_REDDIT_CLIENT_ID=
GEXLENS_NEWS_REDDIT_CLIENT_SECRET=
# Refresh actual z FF kalendare (#277): widget feed actual nenese; 0 = vypnuto
GEXLENS_NEWS_FF_ACTUAL_REFRESH_S=3600
# Kolik tydnu historie stahne `python -m gexlens_news backfill-ff` (3 roky)
GEXLENS_NEWS_FF_BACKFILL_WEEKS=156
# Signal engine (#294): symboly, pro ktere se pocitaji signaly (NQ = pridat)
GEXLENS_NEWS_SIGNAL_SYMBOLS=ES
# PCR rada z vlastnich snapshotu (#290): interval a symboly
GEXLENS_NEWS_PCR_INTERVAL_S=300
GEXLENS_NEWS_PCR_SYMBOLS=ES,NQ
# Okno rolling deduplikace (#273/#351, minuty) — musí pokrýt republikace téže
# story (Δt až hodiny, ADR-0017); strop 1080 drží denní rubriky oddělené
GEXLENS_NEWS_DEDUP_WINDOW_MINUTES=360
# Archiv 1min barů čte news-engine jen ke čtení (#276); v Dockeru /app/data
GEXLENS_NEWS_DATA_DIR=data
# Jak často se dopočítávají reakce na zprávy s uzavřenými okny (s)
GEXLENS_NEWS_REACTION_INTERVAL_S=300
# Ranní retro pass (#284): čas před EU open v UTC, kdy se doženou noční fronty
# Interní ingest API pro WS kanály; v Dockeru http://api:8000 (localhost by
# ukazoval na kontejner news-engine, ne na API)
GEXLENS_NEWS_API_BASE=http://localhost:8000
GEXLENS_NEWS_RETRO_PASS_HOUR=5
GEXLENS_NEWS_RETRO_PASS_MINUTE=30
# Živé broker headlines přes generic tick 292 (#291, Tier D). Stojí jednu
# market data line na symbol; RSS má medián latence 667 s, broker tick chodí živě.
GEXLENS_IBKR_NEWS_ENABLED=true
# Alpaca news WebSocket (#387) — real-time Benzinga headlines, zdarma s paper účtem
GEXLENS_NEWS_ALPACA_KEY_ID=
GEXLENS_NEWS_ALPACA_SECRET=

# tastytrade shadow mód (#613, M7 fáze 1) — default vypnuto; tajemství z OAuth2
# grantu se scope read (ADR-0025), NIKDY heslo. Dev grant má vlastní klíče.
# tastytrade větev (#613, M7): OAuth session, DXLink stream, chain mapa,
# křížová kontrola (#517 A), oba fallbacky (#614) a doplnění OI (#664).
# TRVALÁ součást provozu — bez tajemství níže se stejně nespustí.
GEXLENS_TASTY_ENABLED=true
# Zápis porovnávacích řádků do feed_comparison (#613). DOČASNÉ: vypnout po
# vyhodnocení M7 fáze 2. Tally pro detektor a fallbacky běží dál (#763),
# takže vypnutím se NEztrácí odolnost proti výpadku IBKR — na rozdíl od
# zastaralého GEXLENS_TASTY_SHADOW, který hlídal obojí naráz.
GEXLENS_TASTY_COMPARISON_WRITE=true
# ZASTARALÉ (#763) — nechávej nenastavené. Když je nastaven, řídí
# GEXLENS_TASTY_ENABLED a engine to při startu ohlásí varováním.
# GEXLENS_TASTY_SHADOW=
# CLIENT_ID engine nečte (OAuth refresh flow posílá jen secret + refresh token;
# #707) — klíč patří jen do poznámek ke grantu, ne sem
GEXLENS_TASTY_CLIENT_SECRET=
GEXLENS_TASTY_REFRESH_TOKEN=
# OI fill (#664, kus #614): chybějící OI v denním archivu (typicky 0DTE ráno
# do publikace CME) doplní tasty Summary; IBKR má vždy přednost. Funguje jen
# se zapnutým shadow. Vypnout = flip 0DTE ráno bez OI páteře jako dřív.
GEXLENS_TASTY_OI_FILL=true
# Strop subskribovaných streamer symbolů; 0 = bez stropu (produkce na maximum,
# ADR-0027). Konzervativní hodnotu nastavuje jen dev -LiveTasty (#623), který
# zapíná i GEXLENS_TASTY_ONLY — ručně tyhle dva klíče nenastavuj.
GEXLENS_TASTY_MAX_SUBSCRIPTIONS=0
# DEV grant patří do .env.dev pod standardními názvy GEXLENS_TASTY_* (#696);
# staré GEXLENS_DEV_TASTY_* klíče v .env zůstávají jen jako záloha hodnot

# Křížová kontrola IBKR × tasty (#517 fáze A): pasivní detektor nad shadow
# daty — žádný request na IBKR, žádná market data line navíc. Bez běžícího
# shadow se tiše nezapne. Alertuje jen „IBKR mlčí ∧ tasty data má"; když mlčí
# oba, je to tichý trh a nehlásí se.
# Spot fallback na tastytrade (#614): když IBKR přestane posílat ticky —
# typicky proto, že se přihlásíš na mobilu a market data jsou PER UŽIVATEL
# (error 10197), nebo vypadne datová farma — přebírá cenu podkladu tasty.
# Bez toho cenový graf zamrzne, aniž by cokoli spadlo. Vyžaduje běžící
# shadow větev (bere kotace z téhož dxFeed streamu).
GEXLENS_TASTY_SPOT_FALLBACK=true
# Hystereze na obě strany: přepnutí po 30 s bez IBKR ticku, návrat až po 60 s
# souvislých ticků. Návrat při prvním ticku by při kolísavém spojení znamenal
# přepínání každých pár sekund.
GEXLENS_TASTY_SPOT_STALE_AFTER_S=30
GEXLENS_TASTY_SPOT_RECOVER_AFTER_S=60
GEXLENS_TASTY_SPOT_MAX_AGE_S=30
# Fallback CELÉHO opčního řetězu (#614 fáze 2b): fáze 2a zachránila jen cenu,
# ale heatmapa i GEX stojí na řetězu. Spouští ho verdikt křížové kontroly
# (#517 A), takže dědí její měřené prahy. Po dobu fallbacku stojí CumΔ a net
# objem — tastytrade denní objem v sémantice IBKR nedodává.
GEXLENS_TASTY_CHAIN_FALLBACK=true
# Kolik čistých minut v řadě vrátí řetěz zpět na IBKR (delší než zapínací série)
GEXLENS_TASTY_CHAIN_RECOVER_MINUTES=5
# Max stáří tasty hodnoty, aby kontrakt vstoupil do fallbackového řetězu
GEXLENS_TASTY_CHAIN_MAX_AGE_S=120
# Jak dlouho se při startu čeká na IBKR, než engine rozjede zbytek i bez něj
# (#756). Není to timeout spojení — supervisor se pokouší dál; jen se za
# čekáním nesmí zaseknout tastytrade větev a spot fallback, které IBKR
# nepotřebují. Po startu Windows nebývá TWS spuštěná vůbec. 0 = nečekat.
GEXLENS_STARTUP_CONNECT_WAIT_S=60

GEXLENS_CROSSCHECK_ENABLED=true
# Prahy jsou MĚŘENÉ na 3 016 minutách shadow historie (13.–16. 8. 2026), ne
# odhadnuté: sweep rotace vyhodí podíl „IBKR mlčí" na ~58 % každou třetí
# minutu (dávkování batch_size), ale série tří minut v řadě nenastala ani
# jednou. Snižovat MINUTES pod 3 = falešný poplach každou třetí minutu.
GEXLENS_CROSSCHECK_SHARE_THRESHOLD=0.70
GEXLENS_CROSSCHECK_MINUTES=3
GEXLENS_CROSSCHECK_COOLDOWN_MINUTES=15
# Rozlisovac "tichy trh x mrtva zaloha" (#764): podil kontraktu s menicimi se
# IBKR hodnotami, od ktereho je trh zivy a mlcici tasty porucha -> alert
# feed_backup_dead. Mereno nad 4 833 min historie (13.-19. 8. 2026): pauza CME
# ma median zmen ~0, aktivni trh p5 = 0,38-0,42; prah 0,30 dal 0 planych
# poplachu (bez rozlisovace 6 epizod, vsechny v pauze CME 21-22 UTC).
GEXLENS_CROSSCHECK_CHANGE_THRESHOLD=0.30
# Aktivni IBKR sonda (#517 faze B): na alert ibkr_suspect jednorazovy snapshot
# front future -> rozlisi vypadek farmy (cekat) od mrtvych subskripci (cilena
# obnova bez reconnectu). Nebezi periodicky.
GEXLENS_PROBE_ENABLED=true
# Dohled nad volnym mistem (#773) - jen mereni a alerty (kind disk_space),
# uklid resi #757. Prahy na SKUTECNEM volnem miste disku s datovym adresarem
# (bind mount ukazuje cisla hostitele). Velikost DB ma vlastni prah, protoze
# WSL vhdx s PG volume z kontejneru zmerit nejde; u nas lezi na D: vedle dat,
# takze jeho rust ukusuje z mereneho volneho mista primo. Prah na DB = casna vystraha.
GEXLENS_DISK_FREE_WARN_GB=15
GEXLENS_DISK_FREE_CRIT_GB=5
GEXLENS_DB_SIZE_ALERT_GB=4
