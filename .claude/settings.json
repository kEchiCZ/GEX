{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-I", "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py"],
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
